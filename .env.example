# ============================================================================
# ESCÉNIKA — Variables de Entorno
# Copia este archivo como .env.local para desarrollo local
# Configura estas variables en Vercel > Settings > Environment Variables
# ============================================================================

# ============================================================================
# SUPABASE — Base de datos y autenticación
# Obtén estos valores en: https://supabase.com/dashboard > Settings > API
# ============================================================================

# URL del proyecto Supabase (visible en Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clave pública (anon key) — segura para el frontend
# Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Clave de servicio — SOLO SERVIDOR, nunca expongas en el frontend
# Settings > API > Project API keys > service_role
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================================
# STRIPE — Pagos y suscripciones
# Obtén estos valores en: https://dashboard.stripe.com/apikeys
# ============================================================================

# Clave pública de Stripe — segura para el frontend
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Clave secreta de Stripe — SOLO SERVIDOR
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Secreto del webhook de Stripe
# Obtén este valor en: Stripe Dashboard > Developers > Webhooks > tu endpoint > Signing secret
# El endpoint debe ser: https://tu-dominio.vercel.app/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# IDs de precios de Stripe (Price IDs)
# Obtén estos en: Stripe Dashboard > Products > tu producto > precio
# Crea un producto "Spotlight" con precio 6€/mes y otro "Headliner" con 19€/mes
STRIPE_SPOTLIGHT_PRICE_ID=price_your_spotlight_price_id
STRIPE_HEADLINER_PRICE_ID=price_your_headliner_price_id

# ============================================================================
# APLICACIÓN
# ============================================================================
VITE_APP_URL=http://localhost:5173
NODE_ENV=development
